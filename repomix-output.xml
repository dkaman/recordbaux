func handleLoadPlaylistMsg(s LoadedPlaylistState, msg playlist.LoadPlaylistMsg) (tea.Model, tea.Cmd, tea.Msg) {
	s.logger.Debug("entity message received",
		slog.Any("tracks", msg.Phy.Tracks),
