	h := help.New()
	h.Styles = style.DefaultHelpStyles()

	t := table.New()

	return LoadedBinState{
		svcs:     svcs,
		keys:     defaultKeybinds(),
		logger:   log.WithGroup("loadedbin"),
		handlers: getHandlers(),

		records: t,
	}
}

